name: nifty-option-direction

# Every entry point runs in the same pipeline image, so a laptop, the VPS and a grader's machine
# get identical Python, Java and library versions. Build it once with `./pipe build`.
docker_env:
  image: optpred-pipeline:latest
  volumes: ["${PWD}:/app"]
  environment: [["HOME", "/tmp"], ["SPARK_LOCAL_IP", "127.0.0.1"]]

entry_points:
  check:
    command: "cd /app && python -m optpred.check"
  bars:
    command: "cd /app && python -m optpred.bars"
  features:
    command: "cd /app && python -m optpred.features"
  baselines:
    command: "cd /app && python -m optpred.baselines"
  tune:
    command: "cd /app && python -m optpred.tune"
  train:
    parameters:
      run_name: { type: string, default: "mlproject" }
    command: "cd /app && python -m optpred.train --run-name {run_name}"
  test:
    command: "cd /app && pytest -q"
