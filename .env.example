# Copy to .env (never commit it). All optional.
ADMIN_TOKEN=change-me          # needed by the Retrain / Roll back buttons
BIND=127.0.0.1                 # 0.0.0.0 to reach the stack from other machines
# Where YOUR BROWSER finds the backend. With an SSH tunnel keep the defaults; on a public address:
# API_URL=http://<server-ip>:8000
# MLFLOW_URL=http://<server-ip>:5050
GRAFANA_PASSWORD=admin        # Grafana admin login (anonymous viewing is on)
# REPLAY_DELAY=1               # seconds between replayed minutes
# DRIFT_PSI_LIMIT=0.25          # lower it (e.g. 0.02) with DRIFT_MIN_ROWS=100 to demo drift -> retrain
# DRIFT_MIN_ROWS=1000
