# One image for every pipeline stage: same Python, Java and libraries on any machine.
# Pinned to bookworm: newer Debian dropped Java 17, which Spark 3.5 officially supports.
FROM python:3.11-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless libgomp1 git procps \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system --add safe.directory '*'
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Node.js only to syntax-check the web page script in CI (tests/unit/test_page_script.py). A separate layer
# keeps the pip layer above cached.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml .
COPY src ./src
RUN pip install --no-cache-dir -e .
ENV HOME=/tmp PYTHONUNBUFFERED=1
