# The NAIVE single-stage version of Dockerfile.serve. Kept only to measure the size difference
# (see scripts/image_sizes.sh); nothing runs from it.
FROM python:3.11-bookworm
WORKDIR /app
COPY requirements-serve.txt .
RUN pip install -r requirements-serve.txt
COPY pyproject.toml .
COPY src ./src
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 HOME=/tmp
