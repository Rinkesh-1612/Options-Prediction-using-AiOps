# Serving image (MLflow server, model server, API): MULTI-STAGE, as in the course Docker lecture.
# Stage 1 uses the full Python image to install packages; stage 2 is the slim runtime that receives
# only the installed packages and our code. pip's download cache, wheels and build tools stay behind.

# ---- stage 1: build ----
FROM python:3.11-bookworm AS builder
WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --target=/build/deps -r requirements.txt

# ---- stage 2: runtime ----
FROM python:3.11-slim-bookworm
# libgomp1: LightGBM's threading library (absent from the slim image)
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /build/deps /usr/local/lib/python3.11/site-packages
# `mlflow models serve` launches the `uvicorn` command, so the scripts folder comes along too
COPY --from=builder /build/deps/bin /usr/local/bin
COPY pyproject.toml .
COPY src ./src
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 HOME=/tmp MLFLOW_DISABLE_AGENT_HINT=1
