#!/usr/bin/env bash
# Run any pipeline command inside the pipeline image, on this checkout.
#   ./pipe build                     build the image
#   ./pipe python -m optpred.data.check   run one stage
#   ./pipe dvc repro                 run the whole DAG
# --network host: the export stage reaches Ravion's ClickHouse on 127.0.0.1:9100.
# --user: files written to the repo stay owned by you, not root.
# /etc/passwd + /etc/group (read-only): Spark's Hadoop layer refuses to start for a user ID
# that has no name inside the container ("invalid null input: name").
set -euo pipefail
cd "$(dirname "$0")"
IMAGE=optpred-pipeline:latest
# DVC remote: the folder ../dvc-remote next to this checkout (.dvc/config: url = ../../dvc-remote, relative to
# .dvc/). It is mounted at /dvc-remote, where the same relative path points inside the container.
REMOTE="$(dirname "$PWD")/dvc-remote"
mkdir -p "$REMOTE"
if [[ "${1:-}" == "build" ]]; then
  exec docker build -f docker/Dockerfile.pipeline -t "$IMAGE" .
fi
exec docker run --rm --network host --user "$(id -u):$(id -g)" \
  -e HOME=/tmp -e SPARK_LOCAL_IP=127.0.0.1 -e USER="$(id -un)" -e CH_PASSWORD="${CH_PASSWORD:-}" \
  -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro \
  -v "$PWD":/app -v "$REMOTE":/dvc-remote -w /app "$IMAGE" "$@"
