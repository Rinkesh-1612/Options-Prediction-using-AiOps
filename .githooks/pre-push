#!/usr/bin/env bash
# CI trigger. Git runs this before every push; a non-zero exit stops the push.
# The CI pipeline itself is the DVC DAG (dvc.yaml): `dvc repro gate` reruns every stage whose code, data or
# params changed (lint + tests in stage `tests`), then stage `gate` checks the acceptance criteria.
# Everything runs in the pipeline image, the same one used for real runs.
# Turn it on once:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
command -v git-lfs >/dev/null && git lfs pre-push "$@"
if ! docker image inspect optpred-pipeline:latest >/dev/null 2>&1; then
  echo "pre-push: build the image first: ./pipe build" >&2
  exit 1
fi
echo "== dvc repro gate"; ./pipe dvc repro gate
if ! git diff --quiet -- dvc.lock reports; then
  echo "pre-push: CI changed dvc.lock or reports/. Commit them, then push again." >&2
  exit 1
fi
echo "pre-push: CI passed (dvc.lock and reports match the pushed commit)"
