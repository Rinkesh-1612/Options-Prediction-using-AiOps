{
 "title": "NIFTY signal \u2014 production",
 "uid": "optpred",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "5s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timezone": "browser",
 "tags": [
  "optpred"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Model performance in production",
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Signals per minute, by action",
   "id": 2,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (action) (rate(signals_total[1m])) * 60",
     "legendFormat": "{{action}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Served trades: cumulative net \u20b9 after costs",
   "id": 3,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "signal_net_rupees_cum",
     "legendFormat": "net \u20b9"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyINR"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Hit rate of served trades (1 h)",
   "id": 4,
   "description": "Alert LowHitRate below 35%",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(signal_outcomes_total{result=\"win\"}[1h])) / sum(increase(signal_outcomes_total[1h]))",
     "legendFormat": "hit rate"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
